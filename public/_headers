# En-têtes servis par Cloudflare Pages.

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Les visuels ne changent jamais : cache long.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Polices embarquées : cache long également.
/polices/*
  Cache-Control: public, max-age=31536000, immutable

# Bibliothèque 3D figée à une version : cache long.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# Les coques pèsent de 90 Ko à 1,7 Mo et ne changent qu'à une
# reconversion : une semaine de cache, revalidation ensuite.
/coques/*
  Cache-Control: public, max-age=604800

# Le jeu d'exemple ne doit pas masquer les vraies données.
/exemple/*
  Cache-Control: public, max-age=60

# Clé IndexNow : un fichier texte que Bing vient lire pour vérifier
# que le site et le bot qui le signale sont bien la même maison.
/310aeec1ef8d2edf2626e3cf143476d2.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400
