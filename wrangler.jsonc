{
  // ============================================================
  //  L'ORDRE DU NÉANT — configuration Cloudflare Workers
  // ------------------------------------------------------------
  //  Le dossier public/ est servi tel quel. Tout ce qui n'y
  //  correspond à aucun fichier arrive au Worker, qui ne répond
  //  qu'à /api/ordre et renvoie le reste aux fichiers.
  //
  //  GUILD_ID est déclaré ici : ce n'est pas un secret, il figure
  //  déjà dans l'adresse publique du widget. Il suit donc le dépôt
  //  au lieu de dépendre d'une saisie dans le tableau de bord.
  //
  //  Le jeton du bot, lui, se déclare à la main dans le Worker,
  //  section « Runtime variables and secrets », de type Secret.
  //  Les secrets survivent aux déploiements, ils ne sont jamais
  //  écrasés par ce fichier.
  //
  //  Réglage facultatif, à ajouter au même endroit :
  //    EFFECTIF_NOMS = non   publie les compteurs sans les noms
  // ============================================================

  "name": "ordre-du-neant",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",

  "vars": {
    "GUILD_ID": "1546811036106227722",

    // « oui » masque tout le site derrière la page de chantier.
    // Passer à « non » et pousser suffit à ouvrir le site.
    "CHANTIER": "oui",

    // Ouverture programmée : passé cet instant, le chantier se lève
    // tout seul, sans rien pousser. La page de chantier affiche un
    // compte à rebours et se recharge à l'heure dite. Vider pour
    // revenir à un chantier sans date.
    "OUVERTURE": "2026-09-16T17:30:00+02:00"
  },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",

    // Sans ceci, un fichier existant est servi sans passer par le
    // Worker : la page de chantier ne masquerait alors que les
    // adresses inconnues, et le site resterait visible.
    "run_worker_first": true
  },

  "observability": {
    "enabled": true
  }
}
